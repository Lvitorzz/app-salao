<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.gestao_salao">

    <!-- Permissão de internet (já estava) -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permissões de visibilidade para intent de PROCESS_TEXT (Flutter engine)
         e também para envio de mensagem via WhatsApp -->
    <queries>
        <!-- Processamento de texto (flutter plugin) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Abrir links https://wa.me/… -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https" android:host="wa.me"/>
        </intent>

        <!-- Chamar diretamente o app WhatsApp instalado -->
        <package android:name="com.whatsapp"/>
    </queries>

    <application
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:label="Gestão Salão">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Tema normal após carga do Flutter -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Necessário para plugins gerados pelo Flutter -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

</manifest>
